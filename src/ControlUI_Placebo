    # ------------------- Update Value -------------------      

    def update_accel_value(self, event):
        value = self.accel_slider.get()
        self.accel_slider_label.configure(text=f"Acceleration: {value:.2f} m/s²")
        # Simulate writing to CarMaker by logging the value change
        self.logger.log_value_change([value, None, None, None, None, None, None, None])

